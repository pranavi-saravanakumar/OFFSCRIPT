<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Submit Challenge | Jharkhand Innovation Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        function toggleMenu() {
            const menu = document.getElementById('portalMenu');
            menu.classList.toggle('hidden');
        }
        window.onclick = function(event) {
            if (!event.target.matches('#menuBtn') && !event.target.closest('#menuBtn')) {
                const menu = document.getElementById('portalMenu');
                if (menu && !menu.classList.contains('hidden')) menu.classList.add('hidden');
            }
        }

        // PREVENT DOUBLE SUBMISSION LOCALLY
        function handleFormSubmit(form) {
            const btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.innerText = "Verifying EXIF & Routing via AI...";
            return true;
        }
    </script>
</head>
<body class="bg-slate-50 font-sans">
    <nav class="bg-indigo-900 text-white p-4 shadow-md flex justify-between items-center px-8 relative">
        <div class="flex items-center gap-3">
            <h1 class="text-xl font-bold tracking-wide text-amber-300">Jharkhand Innovation Portal</h1>
            <span class="text-xs bg-indigo-800 px-2 py-0.5 rounded text-indigo-200">Off Script</span>
        </div>

        <div class="flex items-center space-x-6">
            <div class="hidden md:flex space-x-4 text-sm items-center">
                <a href="/" class="hover:text-indigo-200">Home Feed</a>
                <a href="/dashboard" class="hover:text-indigo-200">Analytics Dashboard</a>
                <a href="/lifecycle" class="hover:text-indigo-200">Lifecycle Control</a>
            </div>

            <!-- Top-Right Hamburger Menu -->
            <div class="relative">
                <button id="menuBtn" onclick="toggleMenu()" class="p-2 focus:outline-none bg-indigo-800 hover:bg-indigo-700 rounded-lg transition flex flex-col justify-between w-9 h-9 items-center border border-indigo-700">
                    <span class="w-5 h-0.5 bg-white rounded-full"></span>
                    <span class="w-5 h-0.5 bg-white rounded-full"></span>
                    <span class="w-5 h-0.5 bg-white rounded-full"></span>
                </button>

                <div id="portalMenu" class="hidden absolute right-0 mt-2 w-56 bg-white rounded-xl shadow-xl border border-slate-200 py-2 z-50 text-slate-800">
                    <a href="/dashboard" class="block px-4 py-2.5 text-xs font-semibold hover:bg-indigo-50 hover:text-indigo-600">📊 Analytics Dashboard</a>
                    <a href="/lifecycle" class="block px-4 py-2.5 text-xs font-semibold hover:bg-indigo-50 hover:text-indigo-600">📈 Lifecycle Control Center</a>
                    <a href="/university-portal" class="block px-4 py-2.5 text-xs font-semibold hover:bg-indigo-50 hover:text-indigo-600">🏛️ University Portal</a>
                    <a href="/industry-portal" class="block px-4 py-2.5 text-xs font-semibold hover:bg-indigo-50 hover:text-indigo-600">🏭 Industry Hub</a>
                    <a href="/" class="block px-4 py-2.5 text-xs font-bold text-indigo-600 hover:bg-indigo-50 border-t border-slate-100">🏠 Back to Home</a>
                </div>
            </div>
        </div>
    </nav>

    <div class="max-w-2xl mx-auto my-12 bg-white p-8 rounded-xl shadow-md border border-slate-200">
        <h2 class="text-2xl font-bold text-slate-800 mb-2">Submit a Societal Challenge</h2>
        <p class="text-sm text-slate-500 mb-6">Upload real photo evidence. Our AI performs EXIF GPS metadata verification and anti-spam checks.</p>
        
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="mb-6 p-4 bg-red-100 border border-red-400 text-red-700 rounded-lg text-sm font-medium">
                <%= error %>
            </div>
        <% } %>

        <form action="/submit" method="POST" enctype="multipart/form-data" onsubmit="return handleFormSubmit(this)" class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-slate-700">Unique Citizen ID / Digital Hash</label>
                <input type="text" name="citizenId" required placeholder="e.g., JH-CITIZEN-8492" class="w-full mt-1 p-3 border rounded-lg focus:ring-2 focus:ring-indigo-500 text-sm">
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700">Complaint Title</label>
                <input type="text" name="title" required placeholder="e.g., Pothole on Main Road" class="w-full mt-1 p-3 border rounded-lg focus:ring-2 focus:ring-indigo-500 text-sm">
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700">Detailed Description & Population Impact</label>
                <textarea name="description" rows="3" required placeholder="Describe severity, impact, and people affected (e.g., 10-15 people injured)..." class="w-full mt-1 p-3 border rounded-lg focus:ring-2 focus:ring-indigo-500 text-sm"></textarea>
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700">District / Location</label>
                <input type="text" name="location" required placeholder="e.g., Ranchi, Jharkhand" class="w-full mt-1 p-3 border rounded-lg focus:ring-2 focus:ring-indigo-500 text-sm">
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700">Population / People Affected (Optional)</label>
                <input type="text" name="populationAffected" placeholder="e.g., 10-15 people injured" class="w-full mt-1 p-3 border rounded-lg focus:ring-2 focus:ring-indigo-500 text-sm">
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700">Upload Real Photo Evidence</label>
                <input type="file" name="evidenceImage" required class="w-full mt-1 p-2 border rounded-lg bg-slate-50 text-sm">
                <p class="text-xs text-slate-400 mt-1">Select an actual image file from your computer.</p>
            </div>
            <button type="submit" id="submitBtn" class="w-full bg-indigo-600 text-white font-bold py-3 rounded-lg hover:bg-indigo-700 transition">Upload, Verify & Submit Report</button>
        </form>
    </div>
</body>
</html>