<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Visual Analytics & Impact Dashboard | Off Script</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        function toggleMenu() {
            const menu = document.getElementById('portalMenu');
            menu.classList.toggle('hidden');
        }
        window.onclick = function(event) {
            if (!event.target.matches('#menuBtn') && !event.target.closest('#menuBtn')) {
                const menu = document.getElementById('portalMenu');
                if (menu && !menu.classList.contains('hidden')) menu.classList.add('hidden');
            }
        }
    </script>
</head>
<body class="bg-slate-50 font-sans">
    <nav class="bg-indigo-900 text-white p-4 shadow-md flex justify-between items-center px-8 relative">
        <div class="flex items-center gap-3">
            <h1 class="text-xl font-extrabold tracking-wide text-amber-300">Off Script</h1>
            <span class="text-xs bg-indigo-800 px-2 py-0.5 rounded text-indigo-200">Visual Command Hub</span>
        </div>

        <div class="flex items-center space-x-6">
            <div class="hidden md:flex space-x-4 text-sm">
                <a href="/" class="hover:text-indigo-200">Home</a>
                <a href="/dashboard" class="underline font-semibold text-amber-300">Analytics Dashboard</a>
                <a href="/lifecycle" class="hover:text-indigo-200">Lifecycle Control</a>
            </div>

            <div class="relative">
                <button id="menuBtn" onclick="toggleMenu()" class="p-2 focus:outline-none bg-indigo-800 hover:bg-indigo-700 rounded-lg transition flex flex-col justify-between w-9 h-9 items-center border border-indigo-700">
                    <span class="w-5 h-0.5 bg-white rounded-full"></span>
                    <span class="w-5 h-0.5 bg-white rounded-full"></span>
                    <span class="w-5 h-0.5 bg-white rounded-full"></span>
                </button>

                <div id="portalMenu" class="hidden absolute right-0 mt-2 w-56 bg-white rounded-xl shadow-xl border border-slate-200 py-2 z-50 text-slate-800">
                    <div class="px-4 py-2 border-b border-slate-100">
                        <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Navigation Portals</p>
                    </div>
                    <a href="/dashboard" class="block px-4 py-2.5 text-xs font-semibold hover:bg-indigo-50 hover:text-indigo-600 transition">📊 Analytics Dashboard</a>
                    <a href="/lifecycle" class="block px-4 py-2.5 text-xs font-semibold hover:bg-indigo-50 hover:text-indigo-600 transition">📈 Lifecycle Control Center</a>
                    <a href="/university-portal" class="block px-4 py-2.5 text-xs font-semibold hover:bg-indigo-50 hover:text-indigo-600 transition">🏛️ University Portal</a>
                    <a href="/industry-portal" class="block px-4 py-2.5 text-xs font-semibold hover:bg-indigo-50 hover:text-indigo-600 transition">🏭 Industry Hub</a>
                    <a href="/" class="block px-4 py-2.5 text-xs font-semibold hover:bg-indigo-50 hover:text-indigo-600 transition border-t border-slate-100">🏠 Public Portal Home</a>
                </div>
            </div>
        </div>
    </nav>

    <div class="max-w-7xl mx-auto my-8 px-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 border-l-4 border-indigo-600 flex flex-col justify-between min-h-[140px]">
                <div>
                    <p class="text-xs text-slate-400 font-bold uppercase tracking-wider">Total Challenges</p>
                    <h3 class="text-4xl font-extrabold text-slate-900 mt-2">
                        <%= (typeof stats !== 'undefined' && stats.totalChallenges) ? stats.totalChallenges : 0 %>
                    </h3>
                </div>
                <p class="text-xs text-slate-500 mt-4 pt-3 border-t border-slate-100">Active across districts & verified repositories</p>
            </div>

            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 border-l-4 border-emerald-500 flex flex-col justify-between min-h-[140px]">
                <div>
                    <div class="flex justify-between items-center">
                        <p class="text-xs text-slate-400 font-bold uppercase tracking-wider">Average Completion Rate</p>
                        <h3 class="text-2xl font-extrabold text-slate-900"><%= (typeof stats !== 'undefined' && stats.completedRate) ? stats.completedRate : 0 %>%</h3>
                    </div>
                    <div class="w-full bg-slate-100 rounded-full h-2.5 mt-4">
                        <div class="bg-emerald-500 h-2.5 rounded-full transition-all" style="width: <%= (typeof stats !== 'undefined' && stats.completedRate) ? stats.completedRate : 0 %>%"></div>
                    </div>
                </div>
                <p class="text-xs text-slate-500 mt-4 pt-3 border-t border-slate-100">Overall pipeline progression across phases</p>
            </div>

            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 border-l-4 border-amber-500 flex flex-col justify-between min-h-[140px]">
                <div>
                    <p class="text-xs text-slate-400 font-bold uppercase tracking-wider">Intellectual Property</p>
                    <h3 class="text-3xl font-extrabold text-slate-900 mt-2">
                        <%= (typeof stats !== 'undefined' && stats.patentsCount) ? stats.patentsCount : 0 %> 
                        <span class="text-sm font-medium text-amber-600">Patents Filed</span>
                    </h3>
                </div>
                <p class="text-xs text-slate-500 mt-4 pt-3 border-t border-slate-100">HEI research innovations protected</p>
            </div>

            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 border-l-4 border-purple-500 flex flex-col justify-between min-h-[140px]">
                <div>
                    <p class="text-xs text-slate-400 font-bold uppercase tracking-wider">Startups Incubated</p>
                    <h3 class="text-3xl font-extrabold text-slate-900 mt-2">
                        <%= (typeof stats !== 'undefined' && stats.startupsCount) ? stats.startupsCount : 0 %> 
                        <span class="text-sm font-medium text-purple-600">Registered</span>
                    </h3>
                </div>
                <p class="text-xs text-slate-500 mt-4 pt-3 border-t border-slate-100">Commercialized student ventures</p>
            </div>
        </div>

        <div class="bg-white p-6 rounded-xl shadow border mb-8">
            <h4 class="text-xs font-bold text-slate-500 uppercase mb-2">Domain Distribution (100% Scale)</h4>
            <p class="text-[11px] text-slate-400 mb-4">Proportional breakdown of problems across SIH domains.</p>
            <% 
                let totalC = (typeof stats !== 'undefined' && stats.totalChallenges && stats.totalChallenges > 0) ? stats.totalChallenges : 1;
                let wCount = (typeof stats !== 'undefined') ? stats.waterCount : 0;
                let eCount = (typeof stats !== 'undefined') ? stats.eduCount : 0;
                let aCount = (typeof stats !== 'undefined') ? stats.agriCount : 0;
                let hCount = (typeof stats !== 'undefined') ? stats.healthCount : 0;
                let uCount = (typeof stats !== 'undefined') ? stats.urbanCount : 0;

                let wPct = Math.round((wCount / totalC) * 100);
                let ePct = Math.round((eCount / totalC) * 100);
                let aPct = Math.round((aCount / totalC) * 100);
                let hPct = Math.round((hCount / totalC) * 100);
                let uPct = Math.round((uCount / totalC) * 100);
            %>
            <div class="space-y-3 text-xs">
                <div>
                    <div class="flex justify-between font-semibold mb-1"><span>Water Resources</span><span><%= wCount %> (<%= wPct %>%)</span></div>
                    <div class="w-full bg-slate-100 h-2.5 rounded-full overflow-hidden"><div class="bg-indigo-600 h-2.5 rounded-full" style="width: <%= wPct %>%"></div></div>
                </div>
                <div>
                    <div class="flex justify-between font-semibold mb-1"><span>Education & Skills</span><span><%= eCount %> (<%= ePct %>%)</span></div>
                    <div class="w-full bg-slate-100 h-2.5 rounded-full overflow-hidden"><div class="bg-blue-500 h-2.5 rounded-full" style="width: <%= ePct %>%"></div></div>
                </div>
                <div>
                    <div class="flex justify-between font-semibold mb-1"><span>Agriculture & Rural</span><span><%= aCount %> (<%= aPct %>%)</span></div>
                    <div class="w-full bg-slate-100 h-2.5 rounded-full overflow-hidden"><div class="bg-emerald-500 h-2.5 rounded-full" style="width: <%= aPct %>%"></div></div>
                </div>
                <div>
                    <div class="flex justify-between font-semibold mb-1"><span>Healthcare & Biotech</span><span><%= hCount %> (<%= hPct %>%)</span></div>
                    <div class="w-full bg-slate-100 h-2.5 rounded-full overflow-hidden"><div class="bg-amber-500 h-2.5 rounded-full" style="width: <%= hPct %>%"></div></div>
                </div>
                <div>
                    <div class="flex justify-between font-semibold mb-1"><span>Urban Development</span><span><%= uCount %> (<%= uPct %>%)</span></div>
                    <div class="w-full bg-slate-100 h-2.5 rounded-full overflow-hidden"><div class="bg-purple-500 h-2.5 rounded-full" style="width: <%= uPct %>%"></div></div>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow p-6 mb-8 border border-slate-200">
            <div class="flex items-center justify-between mb-3">
                <h3 class="text-sm font-bold text-slate-800">🔔 Live Tri-Party Activity & Timestamp Feed</h3>
                <span class="text-xs bg-emerald-100 text-emerald-800 px-2.5 py-1 rounded-full font-semibold animate-pulse">Timestamps Active</span>
            </div>
            <div class="space-y-2 max-h-40 overflow-y-auto pr-2">
                <% if (typeof notifications !== 'undefined' && notifications && notifications.length > 0) { %>
                    <% notifications.forEach(function(n) { %>
                        <div class="flex items-center justify-between bg-slate-50 p-2.5 rounded-lg border text-xs">
                            <span class="text-slate-800 font-medium"><%= n.text %></span>
                            <span class="text-slate-500 font-mono bg-white px-2 py-0.5 rounded border ml-4"><%= n.time %></span>
                        </div>
                    <% }); %>
                <% } else { %>
                    <p class="text-xs text-slate-400 italic">No incoming notifications yet.</p>
                <% } %>
            </div>
        </div>

        <div class="flex justify-between items-center mb-4">
            <h3 class="text-xl font-bold text-slate-800">Tri-Party Pipeline & Problem-Solving Timelines</h3>
            <div class="space-x-3 text-xs">
                <a href="/university-portal" class="text-indigo-600 font-bold hover:underline">University Portal ➔</a>
                <a href="/industry-portal" class="text-emerald-600 font-bold hover:underline">Industry Hub ➔</a>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow overflow-hidden border">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-100 text-slate-700 text-xs uppercase">
                        <th class="p-4">Challenge & Timeline Graph</th>
                        <th class="p-4">Community Rep & HEI Lead</th>
                        <th class="p-4">Industry Sponsor & Pledged Value</th>
                        <th class="p-4">Progress & Email Dispatch</th>
                    </tr>
                </thead>
                <tbody class="divide-y text-sm text-slate-600">
                    <% if (typeof challenges !== 'undefined' && challenges && challenges.length > 0) { %>
                        <% challenges.forEach(function(c) { %>
                            <tr>
                                <td class="p-4 w-1/3">
                                    <div class="flex items-center gap-2 mb-1">
                                        <p class="font-bold text-slate-900"><%= c.title %></p>
                                        <span class="text-[10px] font-bold px-2 py-0.5 rounded <%= c.priorityLevel === 'Critical' ? 'bg-rose-100 text-rose-700' : 'bg-amber-100 text-amber-700' %>"><%= c.priorityLevel %></span>
                                    </div>
                                    <p class="text-xs text-rose-600 font-semibold mb-2">👥 Population Affected: <%= c.populationAffected %></p>
                                    <span class="text-xs bg-indigo-50 text-indigo-700 px-2 py-0.5 rounded font-medium inline-block mb-3"><%= c.domain %></span>
                                    
                                    <div class="bg-slate-50 p-3 rounded-lg border text-xs">
                                        <p class="font-bold text-slate-700 mb-2 uppercase text-[10px] tracking-wider">Problem Solving Progression Timeline</p>
                                        <div class="grid grid-cols-4 gap-1.5">
                                            <% if (c.timeline && c.timeline.length > 0) { %>
                                                <% c.timeline.forEach(function(step) { %>
                                                    <div class="p-2 rounded border text-center <%= step.status === 'Completed' ? 'bg-emerald-50 border-emerald-200 text-emerald-800' : (step.status === 'Active' ? 'bg-indigo-50 border-indigo-300 text-indigo-900 font-bold shadow-sm' : 'bg-white text-slate-400') %>">
                                                        <p class="text-[10px] font-bold"><%= step.stage %></p>
                                                        <p class="text-[9px] mt-0.5 font-mono"><%= step.time %></p>
                                                    </div>
                                                <% }); %>
                                            <% } else { %>
                                                <div class="col-span-4 text-center text-slate-400">Timeline initializing...</div>
                                            <% } %>
                                        </div>
                                    </div>
                                </td>
                                <td class="p-4 text-xs space-y-1">
                                    <p>👥 <strong>Community:</strong> <%= c.communityRep || 'Resident Lead' %></p>
                                    <p>🏛️ <strong>Academic:</strong> <%= c.university ? c.university.split(' - ')[0] : 'Pending' %></p>
                                </td>
                                <td class="p-4 text-xs space-y-1">
                                    <p class="text-emerald-700 font-semibold">🤝 <strong>Sponsor:</strong> <%= c.industry || 'Open' %></p>
                                    <p class="font-mono text-slate-700">💰 <strong>Pledged:</strong> <%= c.pledgedValue || '₹0' %></p>
                                </td>
                                <td class="p-4 space-y-2">
                                    <div class="flex items-center gap-2">
                                        <div class="flex-1 bg-slate-100 rounded-full h-2">
                                            <div class="bg-indigo-600 h-2 rounded-full" style="width: <%= c.completionRate || 0 %>%"></div>
                                        </div>
                                        <span class="text-xs font-bold text-slate-700"><%= c.completionRate || 0 %>%</span>
                                    </div>
                                    <div class="mt-2">
                                        <% if (c.emailNotificationStatus) { %>
                                            <p class="text-xs text-emerald-700 bg-emerald-50 p-2 rounded border border-emerald-200 font-medium"><%= c.emailNotificationStatus %></p>
                                        <% } else { %>
                                            <form action="/send-partnership-dispatch/<%= c.id %>" method="POST" class="space-y-1.5">
                                                <input type="email" name="recipientEmail" placeholder="stakeholder@domain.org" class="w-full p-1.5 border rounded text-xs bg-white" required>
                                                <button type="submit" class="w-full bg-indigo-600 text-white text-xs font-bold py-1.5 rounded hover:bg-indigo-700 transition flex items-center justify-center gap-1 shadow-sm">
                                                    <span>📧 Send Briefing Email</span>
                                                </button>
                                            </form>
                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="4" class="p-4 text-center text-slate-400">No challenges found.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>