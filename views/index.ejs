<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Off Script | Community Problem-Solving Platform</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        function toggleMenu() {
            const menu = document.getElementById('portalMenu');
            menu.classList.toggle('hidden');
        }
        window.onclick = function(event) {
            if (!event.target.matches('#menuBtn') && !event.target.closest('#menuBtn')) {
                const menu = document.getElementById('portalMenu');
                if (menu && !menu.classList.contains('hidden')) menu.classList.add('hidden');
            }
        }
    </script>
</head>
<body class="bg-slate-50 font-sans">
    <nav class="bg-indigo-900 text-white p-4 shadow-md flex justify-between items-center px-8 relative">
        <div class="flex items-center gap-3">
            <h1 class="text-xl font-extrabold tracking-wide text-amber-300">Off Script</h1>
            <span class="text-xs bg-indigo-800 px-2 py-0.5 rounded text-indigo-200">Public & Community Portal</span>
        </div>

        <div class="flex items-center space-x-6">
            <div class="hidden md:flex space-x-4 text-sm items-center">
                <a href="/" class="underline font-semibold text-amber-300">Home Feed</a>
                <a href="/dashboard" class="hover:text-indigo-200">Analytics Dashboard</a>
                <a href="/lifecycle" class="hover:text-indigo-200">Lifecycle Control</a>
                <a href="/submit" class="bg-amber-400 text-indigo-950 font-bold px-3 py-1.5 rounded-lg hover:bg-amber-300 transition">+ Report Issue</a>
            </div>

            <div class="relative">
                <button id="menuBtn" onclick="toggleMenu()" class="p-2 focus:outline-none bg-indigo-800 hover:bg-indigo-700 rounded-lg transition flex flex-col justify-between w-9 h-9 items-center border border-indigo-700">
                    <span class="w-5 h-0.5 bg-white rounded-full"></span>
                    <span class="w-5 h-0.5 bg-white rounded-full"></span>
                    <span class="w-5 h-0.5 bg-white rounded-full"></span>
                </button>

                <div id="portalMenu" class="hidden absolute right-0 mt-2 w-56 bg-white rounded-xl shadow-xl border border-slate-200 py-2 z-50 text-slate-800">
                    <a href="/dashboard" class="block px-4 py-2.5 text-xs font-semibold hover:bg-indigo-50 hover:text-indigo-600">📊 Analytics Dashboard</a>
                    <a href="/lifecycle" class="block px-4 py-2.5 text-xs font-semibold hover:bg-indigo-50 hover:text-indigo-600">📈 Lifecycle Control Center</a>
                    <a href="/university-portal" class="block px-4 py-2.5 text-xs font-semibold hover:bg-indigo-50 hover:text-indigo-600">🏛️ University Portal</a>
                    <a href="/industry-portal" class="block px-4 py-2.5 text-xs font-semibold hover:bg-indigo-50 hover:text-indigo-600">🏭 Industry Hub</a>
                    <a href="/submit" class="block px-4 py-2.5 text-xs font-bold text-indigo-600 hover:bg-indigo-50 border-t border-slate-100">+ Report New Issue</a>
                </div>
            </div>
        </div>
    </nav>

    <div class="bg-gradient-to-r from-blue-700 via-indigo-700 to-indigo-900 text-white py-16 px-4 text-center shadow-md">
        <div class="max-w-4xl mx-auto">
            <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight mb-3">Bridging Grassroots Challenges with Academic Excellence</h2>
            <p class="text-sm md:text-base text-indigo-100 max-w-2xl mx-auto mb-8 font-medium">Connecting Citizens, Universities (HEIs), and Industry Partners across Jharkhand for demand-driven technological innovation under NEP 2020.</p>
            <a href="/submit" class="inline-block bg-amber-400 text-indigo-950 font-extrabold px-6 py-3 rounded-xl shadow-lg hover:bg-amber-300 transition text-sm">
                Report a Local Issue Now
            </a>
        </div>
    </div>

    <div class="max-w-7xl mx-auto my-10 px-4">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
            <div>
                <h2 class="text-2xl font-extrabold text-slate-900">Recent Community Challenges</h2>
                <p class="text-xs text-slate-500 mt-0.5">Crowdsourced civic problem statements routed to universities and industry sponsors.</p>
            </div>
            <span class="bg-indigo-50 text-indigo-700 border border-indigo-200 text-xs font-bold px-3 py-1.5 rounded-full shadow-sm">
                ⚡ Sorted by AI Priority Score
            </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <% if (typeof challenges !== 'undefined' && challenges.length > 0) { %>
                <% challenges.forEach(function(c) { %>
                    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 hover:shadow-md transition flex flex-col justify-between">
                        <div>
                            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-3">
                                <span class="text-xs bg-indigo-50 text-indigo-700 font-semibold px-3 py-1 rounded-full"><%= c.domain %></span>
                                <span class="text-xs font-bold px-3 py-1 rounded-full border <%= c.priorityLevel === 'Critical' ? 'bg-rose-50 text-rose-700 border-rose-200' : (c.priorityLevel === 'High' ? 'bg-amber-50 text-amber-700 border-amber-200' : 'bg-blue-50text-blue-700 border-blue-200') %>">
                                    ⚡ <%= c.priorityLevel || 'Medium' %> (<%= c.priorityScore || 50 %>/100)
                                </span>
                            </div>

                            <h3 class="text-xl font-bold text-slate-900 mb-1"><%= c.title %></h3>
                            <p class="text-sm text-slate-600 mb-4"><%= c.description %></p>

                            <% if (c.imagePath) { %>
                                <div class="mb-4">
                                    <img src="<%= c.imagePath %>" alt="Evidence" class="w-full h-48 object-cover rounded-xl border border-slate-200 shadow-sm">
                                </div>
                            <% } %>
                        </div>

                        <div class="border-t border-slate-100 pt-4 mt-4 text-xs text-slate-500 space-y-1">
                            <p>📍 <strong>Location:</strong> <%= c.location %> | 👥 <strong>Reports:</strong> <%= c.reportCount || 1 %></p>
                            <p class="text-rose-600 font-bold">⚠️ Population Affected: <%= c.populationAffected || 'Estimated 5,000 citizens' %></p>
                            <p>🏛️ <strong>Assigned HEI:</strong> <%= c.university || 'Pending Assignment' %></p>
                            <p>🤝 <strong>Industry Partner:</strong> <%= c.industry || 'Open for Partnership (CSR)' %></p>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="col-span-2 bg-white rounded-2xl shadow-sm border p-12 text-center text-slate-400">
                    <p class="text-base font-semibold">No community challenges reported yet.</p>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>